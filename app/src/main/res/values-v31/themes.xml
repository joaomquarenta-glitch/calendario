<resources>
    <!-- Android 12+: the opening screen is the black ground with the app's icon, so it flows straight into the app. -->
    <style name="Theme.Calendario" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:windowSplashScreenBackground">@color/ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ground</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
    </style>
</resources>

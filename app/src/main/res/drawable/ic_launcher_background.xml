<?xml version="1.0" encoding="utf-8"?>
<!-- A deep blue-to-indigo glow behind the tiles, like Apple's own icons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="10"
                android:endX="90"
                android:endY="98">
                <item android:offset="0" android:color="#FF3D9BFF" />
                <item android:offset="0.55" android:color="#FF007AFF" />
                <item android:offset="1" android:color="#FF4B3FD8" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Soft light from the top-left corner -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30"
                android:centerY="24"
                android:gradientRadius="70">
                <item android:offset="0" android:color="#33FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
